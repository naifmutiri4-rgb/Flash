
<style>
.grain::after{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.035) 1px,transparent 1px);background-size:4px 4px;pointer-events:none}
.b .g{padding-bottom:26px;margin-bottom:-16px}
.odo{display:flex;gap:14px;direction:ltr}
.dg{width:118px;height:176px;border-radius:24px;background:linear-gradient(180deg,#1E1B38 0,#16142A 48%,#0F0D1F 52%,#16142A);border:1px solid #2A2550;display:grid;place-items:center;font-family:Readex;font-weight:700;font-size:120px;position:relative;box-shadow:inset 0 -8px 20px rgba(0,0,0,.4)}
.dg::after{content:"";position:absolute;left:0;right:0;top:50%;height:2px;background:#0B0A12}
.sep{font-family:Readex;font-weight:700;font-size:110px;color:#3A3560;align-self:flex-end;line-height:1}
.neon{font-family:Readex;font-weight:700;color:#fff;text-shadow:0 0 6px #fff,0 0 18px var(--pk),0 0 40px var(--pk),0 0 80px var(--pk)}
.neon2{font-family:Readex;font-weight:700;color:#E9FFFD;text-shadow:0 0 6px #fff,0 0 18px var(--cy),0 0 40px var(--cy),0 0 80px var(--cy)}
.cp{position:absolute;display:flex;border-radius:30px;overflow:hidden;box-shadow:0 50px 120px -30px rgba(255,61,127,.55)}
.pm{position:absolute;height:120px;border-radius:26px;display:flex;align-items:center;justify-content:center;font-family:Readex;font-weight:700;font-size:36px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(10px)}
.msg{position:absolute;max-width:440px;padding:18px 24px;border-radius:26px;font-size:24px;line-height:1.5}
.msg small{display:block;font-size:16px;opacity:.6;margin-top:4px;direction:ltr;text-align:left}
</style>

<!-- 1: odometer -->
<section class="b grain" id="m1" style="background:radial-gradient(900px 500px at 30% 50%,#191240 0,transparent 70%),var(--bg)">
  <div style="position:absolute;left:110px;top:150px">
    <div style="color:var(--mut);font-size:26px;margin-bottom:22px;display:flex;align-items:center;gap:12px"><svg width="30" height="30" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" fill="none" stroke="#00E5D4" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="#00E5D4"/></svg>مشاهدات مقطعك</div>
    <div class="odo">
      <div class="dg">2</div><div class="dg">0</div><span class="sep">,</span><div class="dg">0</div><div class="dg">0</div><div class="dg" style="color:var(--cy);box-shadow:0 0 0 2px var(--cy),0 0 50px -6px var(--cy)">0</div>
    </div>
    <div style="display:flex;gap:14px;margin-top:30px;direction:rtl;justify-content:flex-end">
      <span class="chip"><i class="dot" style="background:var(--pk)"></i>+250 لايك</span>
      <span class="chip"><i class="dot" style="background:#8B5CFF"></i>+50 شير</span>
      <span class="chip"><i class="dot" style="background:var(--yl)"></i>+50 حفظ</span>
    </div>
  </div>
  <img class="logo" src="logo.png">
  <div class="copy" style="top:175px;width:780px">
    <h1 style="font-size:98px">العدّاد يشتغل<br><span class="g">بعد الدفع</span></h1>
    <p class="sub" style="margin-top:12px">تنفيذ آلي مباشرة، بدون انتظار رد ولا تحويل يدوي</p>
    <a class="cta c1" style="margin-top:28px">ابدأ طلبك <i>‹</i></a>
  </div>
</section>

<!-- 2: neon sign -->
<section class="b" id="m2" style="background:linear-gradient(180deg,#0D0B16,#08070D)">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:64px 32px"></div>
  <div class="glow" style="width:700px;height:360px;left:110px;top:150px;background:var(--pk);opacity:.22"></div>
  <div style="position:absolute;left:120px;top:100px;width:720px;height:440px;border-radius:40px;border:3px solid rgba(255,61,127,.55);box-shadow:0 0 30px rgba(255,61,127,.35),inset 0 0 30px rgba(255,61,127,.2)"></div>
  <div style="position:absolute;left:120px;top:140px;width:720px;text-align:center">
    <div class="neon2" style="font-size:54px">خلّ مقطعك</div>
    <div class="neon" style="font-size:150px;line-height:1.25">يطلع</div>
    <div class="neon2" style="font-size:96px;line-height:1">اكسبلور ⚡</div>
  </div>
  <img class="logo" src="logo.png">
  <div class="copy" style="top:185px;width:760px">
    <h1 style="font-size:88px">مقطعك حلو؟<br><span class="pk">خلّ الناس تشوفه.</span></h1>
    <p class="sub" style="margin-top:14px">مشاهدات ولايكات وشير وحفظ، برابط المقطع فقط</p>
    <a class="cta c2" style="margin-top:28px">تسوّق الخدمات</a>
  </div>
</section>

<!-- 3: coupon -->
<section class="b grain" id="m3" style="background:radial-gradient(800px 500px at 25% 55%,#3A1240 0,transparent 70%),var(--bg)">
  <div class="cp" style="left:120px;top:150px;width:800px;height:340px;transform:rotate(-4deg)">
    <div style="width:560px;background:linear-gradient(135deg,#FF3D7F,#B44DFF);padding:40px 46px;position:relative">
      <div style="font-size:28px;font-weight:700;opacity:.9">خصم على كل الخدمات</div>
      <div style="font-family:Readex;font-weight:700;font-size:170px;line-height:1;margin-top:6px;direction:ltr;text-align:right">10%</div>
      <div style="font-size:22px;opacity:.85;margin-top:8px">مشاهدات · لايكات · شير · حفظ · باقات</div>
    </div>
    <div style="width:240px;background:#F7F5FF;color:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;border-right:4px dashed #0B0A12">
      <div style="font-size:22px;color:#6B6790">الكود</div>
      <div style="font-family:Readex;font-weight:700;font-size:84px;letter-spacing:4px;direction:ltr">F10</div>
      <div style="font-size:20px;color:#6B6790">انسخه عند الدفع</div>
    </div>
    <div style="position:absolute;left:540px;top:-22px;width:44px;height:44px;border-radius:50%;background:#1C0E24"></div>
    <div style="position:absolute;left:540px;bottom:-22px;width:44px;height:44px;border-radius:50%;background:#160C1E"></div>
  </div>
  <img class="logo" src="logo.png">
  <div class="copy" style="top:185px;width:760px">
    <h1 style="font-size:96px">كودك جاهز،<br><span class="pk">استخدمه الحين</span></h1>
    <p class="sub" style="margin-top:12px">اكتب <b style="color:#fff;direction:ltr;unicode-bidi:isolate">F10</b> في السلة وينزل السعر 10% على طول</p>
    <a class="cta c2" style="margin-top:28px">تسوّق بالخصم</a>
  </div>
</section>

<!-- 4: payments -->
<section class="b" id="m4" style="background:linear-gradient(135deg,#0B0A12 40%,#0E2A2E)">
  <div class="glow" style="width:520px;height:520px;left:260px;top:60px;background:var(--cy);opacity:.2"></div>
  <div class="pm" style="left:120px;top:110px;width:300px;transform:rotate(-5deg)">مدى</div>
  <div class="pm" style="left:460px;top:80px;width:330px;transform:rotate(4deg)">Apple Pay</div>
  <div class="pm" style="left:170px;top:280px;width:340px;transform:rotate(3deg);color:#B9A6FF">STC Pay</div>
  <div class="pm" style="left:540px;top:260px;width:300px;transform:rotate(-4deg)">فيزا · ماستر</div>
  <div style="position:absolute;left:330px;top:430px;display:flex;align-items:center;gap:18px;background:#F7F5FF;color:var(--bg);border-radius:26px;padding:20px 30px;box-shadow:0 30px 70px -20px rgba(0,229,212,.5)">
    <div style="width:64px;height:64px;border-radius:18px;background:#12C9A0;display:grid;place-items:center"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 9.3 8 11 4.6-1.7 8-6 8-11V5l-8-3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg></div>
    <div><b style="font-family:Readex;font-size:30px;display:block">الدفع عن طريق سلة</b><span style="color:#5E5A78;font-size:21px">بوابة دفع آمنة ومعتمدة</span></div>
  </div>
  <img class="logo" src="logo.png">
  <div class="copy" style="top:185px;width:760px">
    <h1 style="font-size:96px">ادفع بالطريقة<br><span class="cy">اللي تريحك</span></h1>
    <p class="sub" style="margin-top:26px">ولا نطلب منك كلمة مرور حسابك أبداً</p>
    <a class="cta c1" style="margin-top:28px">اطلب الحين <i>‹</i></a>
  </div>
</section>

<!-- 5: whatsapp support -->
<section class="b grain" id="m5" style="background:radial-gradient(800px 500px at 30% 50%,#10302C 0,transparent 70%),var(--bg)">
  <div style="position:absolute;left:150px;top:40px;width:640px;height:560px;border-radius:40px;background:#111020;border:1px solid #2A2550;overflow:hidden">
    <div style="height:96px;background:#16142A;display:flex;align-items:center;gap:16px;padding:0 28px;border-bottom:1px solid #2A2550">
      <img src="icon.png" style="width:56px;height:56px;border-radius:16px">
      <div><b style="font-size:26px">فلاش ستور</b><div style="color:#25D366;font-size:19px">● متصل الحين</div></div>
    </div>
    <div class="msg" style="right:28px;top:130px;background:#2A2550">السلام عليكم، متى يبدأ طلبي؟<small>10:24 ✓✓</small></div>
    <div class="msg" style="left:28px;top:250px;background:#0F5C4E">وعليكم السلام 👋 يبدأ آلياً بعد الدفع مباشرة، وتقدر تتابعه من حسابك.<small>10:25</small></div>
    <div class="msg" style="right:28px;top:410px;background:#2A2550">ممتاز، يعطيكم العافية 🤍<small>10:26 ✓✓</small></div>
  </div>
  <div style="position:absolute;left:90px;top:480px;width:110px;height:110px;border-radius:50%;background:#25D366;display:grid;place-items:center;box-shadow:0 20px 60px -10px rgba(37,211,102,.6)"><svg width="60" height="60" viewBox="0 0 24 24" fill="#fff"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.4 1.8 2.2 1.2 1.1 2.2 1.4 2.5 1.6.3.1.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/></svg></div>
  <img class="logo" src="logo.png">
  <div class="copy" style="top:185px;width:760px">
    <h1 style="font-size:96px">عندك سؤال؟<br><span style="color:#25D366">كلّمنا واتساب</span></h1>
    <p class="sub" style="margin-top:24px">دعم عربي يرد عليك قبل وبعد الطلب</p>
    <a class="cta" style="margin-top:28px;background:#25D366;color:#06210F">تواصل معنا</a>
  </div>
</section>

</body></html>
