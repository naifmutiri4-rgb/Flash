
<style>
.d{width:728px;height:90px;position:relative;overflow:hidden;background:var(--bg);margin:10px}
.m{width:390px;height:195px;position:relative;overflow:hidden;background:var(--bg);margin:10px}
.ab{position:absolute}
.hd{font-family:Readex;font-weight:700;line-height:1.1;text-align:right}
.g2{background:linear-gradient(90deg,var(--pk),var(--cy));-webkit-background-clip:text;background-clip:text;color:transparent;padding-bottom:5px}
.bt{display:inline-flex;align-items:center;justify-content:center;font-family:Readex;font-weight:600;border-radius:999px;white-space:nowrap}
.gr::after{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.035) 1px,transparent 1px);background-size:3px 3px;pointer-events:none}
.bb{position:absolute;border-radius:12px 12px 4px 12px;font-weight:600;line-height:1.4;box-shadow:0 10px 24px -12px rgba(0,0,0,.8)}
.bb i{display:block;font-style:normal;color:#FFC94D;letter-spacing:1px}
.bb i span{color:#C2BEDD;letter-spacing:0;margin-right:4px}
.tk{position:absolute;background:#F7F5FF;color:#0B0A12;border-radius:10px;box-shadow:0 20px 40px -15px rgba(0,0,0,.9)}
.rw{display:flex;justify-content:space-between;align-items:center}
.ck{display:inline-grid;place-items:center;border-radius:50%;background:#12C9A0;color:#fff;font-weight:700;margin-left:4px}
.wa{position:absolute;border-radius:12px;line-height:1.45}
.vt{position:absolute;border-radius:10px;overflow:hidden;border:1px solid #2A2550}
.vt .c{position:absolute;left:5px;right:5px;bottom:5px;border-radius:7px;background:rgba(11,10,18,.8);padding:3px 6px;text-align:right}
.vt .c b{font-family:Readex;font-weight:700;direction:ltr;display:block}
</style>
<svg width="0" height="0" style="position:absolute"><defs>
<symbol id="play" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="rgba(255,255,255,.16)"/><path d="M10 8l6 4-6 4z" fill="#fff"/></symbol>
<symbol id="wa" viewBox="0 0 24 24"><path fill="#fff" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.4 1.8 2.2 1.2 1.1 2.2 1.4 2.5 1.6.3.1.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/></symbol>
<symbol id="bolt2" viewBox="0 0 150 130"><defs><linearGradient id="ar" x1="0" x2="1"><stop offset="0" stop-color="#FF3D7F"/><stop offset="1" stop-color="#00E5D4"/></linearGradient></defs><path d="M86 2 30 72h40l-10 56 58-74H76z" fill="url(#ar)"/></symbol>
</defs></svg>

<!-- ===== A: WhatsApp ===== -->
<section class="d gr" id="dA" style="background:radial-gradient(360px 140px at 30% 50%,#10302C 0,var(--bg) 75%)">
  <div class="wa" style="left:130px;top:8px;max-width:170px;background:#2A2550;padding:6px 10px;font-size:11px">السلام عليكم، متى يبدأ طلبي؟</div>
  <div class="wa" style="left:40px;top:44px;max-width:240px;background:#0F5C4E;padding:6px 10px;font-size:11px">وعليكم السلام 👋 يبدأ آلياً بعد الدفع مباشرة</div>
