  <div class="ab" style="right:80px;top:55px;font-size:13px;color:var(--mut)">دعم عربي يرد عليك قبل وبعد الطلب</div>
</section>
<section class="m gr" id="mA" style="background:radial-gradient(260px 200px at 30% 55%,#10302C 0,var(--bg) 75%)">
